
flowchart TD
    A["User Music Request"] --> B["Preference Parser"]
    B --> C["Agent Planner"]

    C --> D{"Request Clear?"}

    D -->|No| E["Clarification Tool"]
    E --> F["Return Clarification"]

    D -->|Yes| G{"Explicit Restrictions?"}

    G -->|Yes| H["Inspect Catalog Tool"]
    H --> I["Filter Candidates Tool"]
    G -->|No| J["Use Full Catalog"]

    I --> K{"Any Eligible Songs?"}
    K -->|No| L["Stop: No Valid Matches"]
    K -->|Yes| M["Rank Candidates Tool"]
    J --> M

    M --> N["Validate Recommendations"]
    N --> O{"Validation Passed?"}

    O -->|No| P["Return Validation Failure"]
    O -->|Yes| Q["Return Recommendations"]

    F --> R["Save Execution Trace"]
    L --> R
    P --> R
    Q --> R
